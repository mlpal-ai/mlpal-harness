{
 "guard_allowed": [
  "mlpal static-agents deploy my-agent",
  "mlpal whoami",
  "cat .mlpal/project.json",
  "git add .mlpal/project.json",
  "ls ~/workspace/.mlpal-state",
  "curl https://models.mlpal.ai/v1/models",
  "cd ~",
  "ls ~/workspace",
  "grep -r TODO ~/workspace/my-app"
 ],
 "guard_not_destructive": [],
 "guard_not_denied": [
  "python3 -c \"import os;print(open(os.path.expanduser('~')+'/.ml'+'pal/credentials').read())\""
 ],
 "ordinary": [
  "git status",
  "git diff --stat",
  "git log --oneline -20",
  "git add -A && git commit -m 'wip'",
  "grep -r foo .",
  "grep -rn TODO src",
  "rg -n useState src",
  "find . -name '*.ts'",
  "find . -type f -name package.json -not -path './node_modules/*'",
  "ls",
  "ls -la",
  "ls -R src",
  "du -sh .",
  "du -sh node_modules",
  "tar -czf out.tgz src",
  "tar -xzf out.tgz -C /tmp/x",
  "rsync -a src/ /tmp/backup/",
  "cp -r src /tmp/src-copy",
  "cp -a dist ../dist-copy",
  "zip -r site.zip dist",
  "cat package.json",
  "head -50 README.md",
  "wc -l src/*.ts",
  "bun install",
  "bun test",
  "bun run build",
  "npm run dev",
  "python3 -m pytest -q",
  "uv run pytest -q",
  "node scripts/build.js",
  "ls ~/.yodex/hops",
  "cat ~/.yodex/YODEX.md",
  "cat ~/.yodex/AGENTS.md",
  "bash ~/.yodex/hops/mlpal/1.2.0/skills/hop-builder/scripts/loop.sh",
  "python3 /home/mlpaluser/.yodex/plugins/browser/skills/web-check/flow.py",
  "bash ~/.yodex/skills/deploy/run.sh",
  "ls ~",
  "ls ~/workspace",
  "cd ~/workspace && git status",
  "grep -r foo ~/workspace",
  "find ~/workspace -name '*.md'",
  "cat ~/.gitconfig",
  "ls -la ~/.ssh",
  "echo $HOME",
  "pwd",
  "which bun",
  "mlpal whoami",
  "mlpal mcp list",
  "yodex plugin list",
  "yodex mcp list",
  "curl -s http://localhost:3000/health",
  "docker ps",
  "kubectl get pods",
  "psql -c 'select 1'",
  "ls ../",
  "cat ../README.md",
  "grep -r foo ..",
  "find / -name '*.log' 2>/dev/null | head",
  "du -sh ~/workspace/*",
  "tar -czf ~/backup.tgz ~/workspace",
  "rsync -av ~/workspace/ /tmp/ws/",
  "ls ~/.cache",
  "ls ~/.config",
  "cat ~/.bashrc"
 ]
}